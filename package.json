{
  "type": "module",
  "name": "@thalalabs/aptx",
  "version": "0.1.0",
  "description": "Lightweight CLI for simulating and submitting Aptos transactions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aptx": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "release:changeset": "pnpm changeset",
    "release:version": "pnpm changeset version",
    "release:publish": "pnpm build && pnpm changeset publish"
  },
  "keywords": [
    "aptos",
    "transaction",
    "cli",
    "blockchain",
    "simulation"
  ],
  "author": "ThalaLabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThalaLabs/aptx.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^1.35.0",
    "chalk": "5.3.0",
    "commander": "^12.1.0",
    "yaml": "^2.6.1"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
